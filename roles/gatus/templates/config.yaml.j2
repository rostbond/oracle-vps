ui:
  title: "Skyfall"
  header: "Skyfall"

storage:
  type: sqlite
  path: /data/data.db

alerting:
  custom:
    url: "https://api.pushover.net/1/messages.json"
    method: "POST"
    headers:
      Content-Type: "application/json"
    body: |
      {
        "token": "{{ vault_gatus_pushover_token }}",
        "user": "{{ vault_gatus_pushover_user }}",
        "title": "Gatus",
        "message": "[ALERT_TRIGGERED_OR_RESOLVED] [ENDPOINT_NAME]",
        "priority": 0
      }
    placeholders:
      ALERT_TRIGGERED_OR_RESOLVED:
        TRIGGERED: "🔴"
        RESOLVED: "🟢"
    default-alert:
      failure-threshold: 2
      success-threshold: 1
      send-on-resolved: true

maintenance:
  start: 04:25
  duration: 2h
  timezone: "Europe/Madrid"

endpoints:
  - name: "backup.legoland.tech"
    group: "Servarica"
    url: "https://backup.legoland.tech"
    interval: 60s
    ui:
      hide-hostname: true
      hide-url: true
      hide-conditions: true
    conditions:
      - "[STATUS] == 200"
    alerts:

  - name: "bondarch.uk"
    group: "Digital Ocean"
    url: "https://bondarch.uk"
    interval: 60s
    ui:
      hide-hostname: true
      hide-url: true
      hide-conditions: true
